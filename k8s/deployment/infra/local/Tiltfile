load('../../../../utils/tilt/k8s/pvc.utils.tilt', 'clear_pvc')
load('../../../../utils/tilt/k8s/namespace.utils.tilt', 'create_namespace')

def setup_local_infra():
    # Namespace
    k8s_yaml('k8s/deployment/infra/local/namespace.yaml')

    # PVC cleanup resources (manual trigger from Tilt UI for fresh volumes)
    clear_pvc('postgresql-data', 'aicp')
    clear_pvc('redis-data', 'aicp')

    # PostgreSQL
    k8s_yaml('k8s/deployment/infra/local/postgresql.yaml')
    k8s_resource('postgresql',
        objects=['postgresql-init:configmap', 'postgresql-data:persistentvolumeclaim'],
        port_forwards=['5432:5432'],
        labels=['01_infra'],
    )

    # Redis
    k8s_yaml('k8s/deployment/infra/local/redis.yaml')
    k8s_resource('redis',
        objects=['redis-data:persistentvolumeclaim'],
        port_forwards=['6379:6379'],
        labels=['01_infra'],
    )

    # pgAdmin
    k8s_yaml('k8s/deployment/infra/local/pgadmin.yaml')
    k8s_resource('pgadmin',
        objects=['pgadmin-servers:configmap', 'pgadmin-pgpass:configmap'],
        port_forwards=['5050:80'],
        resource_deps=['postgresql'],
        labels=['01_infra_dashboard'],
    )

    # Prometheus
    k8s_yaml('k8s/deployment/infra/local/prometheus.yaml')
    k8s_resource('prometheus',
        objects=['prometheus-config:configmap', 'prometheus-data:persistentvolumeclaim'],
        port_forwards=['9091:9090'],
        labels=['01_infra'],
    )
    clear_pvc('prometheus-data', 'aicp')

    # Grafana dashboards ConfigMap (source: deploy/grafana/dashboards/*.json)
    k8s_yaml('k8s/deployment/infra/local/grafana-dashboards.yaml')

    # Grafana
    k8s_yaml('k8s/deployment/infra/local/grafana.yaml')
    k8s_resource('grafana',
        objects=[
            'grafana-datasources:configmap',
            'grafana-dashboard-provisioning:configmap',
            'grafana-dashboards:configmap',
        ],
        port_forwards=['3000:3000'],
        resource_deps=['prometheus'],
        labels=['01_infra_dashboard'],
    )

    # Traefik Ingress routes (*.localhost:8081 → services)
    # grafana.localhost:8081, pgadmin.localhost:8081, prometheus.localhost:8081,
    # aicp.localhost:8081, metrics.localhost:8081
    k8s_yaml('k8s/deployment/infra/local/ingress.yaml')
    k8s_resource(
        new_name='ingress-routes',
        objects=[
            'grafana-ingress:ingress',
            'pgadmin-ingress:ingress',
            'prometheus-ingress:ingress',
            'aicp-server-ingress:ingress',
        ],
        resource_deps=['grafana', 'pgadmin', 'prometheus'],
        labels=['01_infra'],
    )
