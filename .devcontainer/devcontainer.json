// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at:
// https://github.com/microsoft/vscode-dev-containers/tree/v0.234.0/containers/ubuntu
{
  "name": "aicp-dev",
  "build": {
    "dockerfile": "Dockerfile",
    // Update 'VARIANT' to pick an Ubuntu version: jammy / ubuntu-22.04, focal / ubuntu-20.04
    // Use ubuntu-22.04 on local arm64/Apple Silicon.
    "args": {
      "VARIANT": "jammy",
      "OPERATOR_SDK_VERSION": "v1.42.2",
      "OPERATOR_SDK_ARCH": "arm64",
      "OPERATOR_SDK_OS": "linux"
    }
  },
  "runArgs": [
    "--cpus=4",
    "--memory=8g",
    "--hostname=localhost",
    "--network=host",
    "--name=vsc-aicp-dev"
  ],
  "workspaceFolder": "/workspaces/aicp",
  "containerEnv": {
    "HOST_PROJECT_ROOT": "${localWorkspaceFolder}",
    "DOCKER_BUILDKIT": "1"
  },
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
    "source=${localEnv:HOME}/.kube,target=/tmp/host/.kube,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/tmp/host/.gitconfig,type=bind,readonly",
    "source=/etc/localtime,target=/etc/localtime,type=bind",
    // Persist Claude Code conversations and memory across rebuilds
    "source=aicp-claude-config,target=/home/vscode/.claude,type=volume"
  ],
  "remoteEnv": {
    "SYNC_LOCALHOST_KUBECONFIG": "true",
    "KUBECONFIG": "/home/vscode/.kube/config"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "go.useLanguageServer": true,
        "dev.containers.copyGitConfig": true
      },
      "extensions": [
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "tilt-dev.tiltfile",
        "golang.go",
        "Anthropic.claude-code",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "esbenp.prettier-vscode",
        "PKief.material-icon-theme",
        "streetsidesoftware.code-spell-checker",
        "mikestead.dotenv"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-from-docker:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [
    5432,  // postgres
    6379,  // redis
    8080,  // aicp server
    9090,  // metrics
    5005,  // registry
    10350  // tilt
  ],
  // Runs on the HOST before container creation - ensures bind-mount source paths exist
  "initializeCommand": "chmod +x .devcontainer/scripts/init_host.sh && .devcontainer/scripts/init_host.sh",
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "chmod +x .devcontainer/scripts/post_cmd.sh && .devcontainer/scripts/post_cmd.sh",
  // Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
  "remoteUser": "vscode"
}
