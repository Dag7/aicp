def clear_pvc(pvc_name, namespace='aicp', labels=['01_cleanup']):
    """Register a manual local_resource to clear finalizers on a PVC.

    Patches the PVC to remove finalizers so it can be deleted cleanly.
    The resource is auto_init=False -- trigger it manually from the Tilt UI
    when you need a fresh volume.

    Returns the resource name so it can be used as a dependency.
    """
    name = 'clear-%s' % pvc_name
    local_resource(
        name,
        cmd="kubectl patch pvc %s -p '{\"metadata\":{\"finalizers\":null}}' --type=merge -n %s || true" % (pvc_name, namespace),
        auto_init=False,
        labels=labels,
    )
    return name
