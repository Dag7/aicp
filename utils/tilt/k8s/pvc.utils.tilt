def clear_pvc(pvc_name, namespace, labels={}):
    """Clear a PVC for fresh dev starts.

    Deletes the PVC either by name or by label selector so that local
    development always starts with a clean volume.

    Args:
        pvc_name: Name of the PVC to delete (used when no labels given).
        namespace: Kubernetes namespace containing the PVC.
        labels: Optional dict of label selectors (used instead of name when provided).
    """
    label_selector = ','.join(['%s=%s' % (k, v) for k, v in labels.items()])
    if label_selector:
        local('kubectl delete pvc -n %s -l %s --ignore-not-found=true 2>/dev/null || true' % (namespace, label_selector), quiet=True)
    else:
        local('kubectl delete pvc %s -n %s --ignore-not-found=true 2>/dev/null || true' % (pvc_name, namespace), quiet=True)
